    <UserSecretsId>752c41ac-5762-4dc3-add9-1e5d2b68db2c</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
